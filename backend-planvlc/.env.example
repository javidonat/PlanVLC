PORT=3000
MONGODB_URI=mongodb://localhost:27017/planvlc
# Clave para firmar y verificar los JWT. Pon una larga y aleatoria y no la subas nunca a git
# (por ejemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
SECRET=
# Caducidad del access token (cookie access_token): 15m, 1h...
JWT_EXPIRES_IN=1h
# Días que dura el refresh token (cookie refresh_token): pasado ese tiempo hay que volver a hacer login
REFRESH_TOKEN_DAYS=7
