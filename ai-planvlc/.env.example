# Servicio de IA. Solo lo llama la API Gateway (gateway-planvlc), nunca el navegador
PORT=3001

# Clave de OpenRouter (openrouter.ai → Keys). No la subas nunca a git
OPENROUTER_API_KEY=
# Modelo de OpenRouter. Los que terminan en ":free" son gratis (con límite de peticiones al día).
# Si deja de existir, elige otro gratis en https://openrouter.ai/models?q=free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Clave compartida con la gateway: el servicio rechaza las peticiones que no la traen
# (así nadie puede llamarlo directamente saltándose la gateway). La misma en gateway-planvlc/.env
GATEWAY_SECRET=
