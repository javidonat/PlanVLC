# API Gateway: la única puerta de entrada para el frontend (Angular llama siempre aquí)
PORT=4000

# Origen del frontend: solo esta web puede llamar a la API desde el navegador (CORS)
FRONTEND_URL=http://localhost:4200

# A dónde reenvía cada petición
BACKEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:3001

# Clave compartida con el servicio de IA (la misma en ai-planvlc/.env). No la subas nunca a git
GATEWAY_SECRET=
